DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@127.0.0.1:5432/monitor_ti?schema=public"

PORT=4000

# Operador humano do Dashboard. Gere o hash fora do repositorio com scrypt.
HT_ADMIN_USERNAME=admin
HT_ADMIN_PASSWORD_HASH=scrypt$N$r$p$salt$derivedKey
# Use true somente quando o Dashboard estiver servido por HTTPS.
HT_AUTH_COOKIE_SECURE=false

# Caminho local do arquivo DPAPI protegido e conta Windows esperada pelo helper.
CERTIFICATE_SMB_CREDENTIAL_FILE=
CERTIFICATE_SMB_EXPECTED_SERVICE_IDENTITY=
