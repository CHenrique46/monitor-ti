generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Computador {
  id            Int      @id @default(autoincrement())
  deviceId      String   @unique
  hostname      String
  usuario       String?
  ip            String?
  sistema        String?
  arquitetura    String?
  processador    String?
  cpusLogicas    Int?
  sistemaRelease String?
  fabricante          String?
  modeloEquipamento   String?
  placaMaeFabricante  String?
  placaMaeModelo      String?
  biosFabricante      String?
  biosVersao          String?
  numeroSerie         String?
  status        String   @default("offline")
  ultimaConexao DateTime?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  // Estado atual de monitoramento (unidades: bytes para RAM/disco, segundos para uptime)
  cpuUso        Float?
  ramTotal      Float?
  ramUsada      Float?
  discoTotal    Float?
  discoLivre    Float?
  uptime        Float?
  ultimaMetrica DateTime?

  discosFisicos DiscoFisico[]
}

model DiscoFisico {
  id           Int       @id @default(autoincrement())
  computadorId Int
  modelo       String?
  tamanho      Float?
  interface    String?

  computador   Computador @relation(fields: [computadorId], references: [id], onDelete: Cascade)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
}
