generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Computador {
  id            Int      @id @default(autoincrement())
  deviceId      String   @unique
  hostname      String
  usuario       String?
  ip            String?
  sistema        String?
  arquitetura    String?
  processador    String?
  cpusLogicas    Int?
  sistemaRelease String?
  status        String   @default("offline")
  ultimaConexao DateTime?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  // Estado atual de monitoramento (unidades: bytes para RAM/disco, segundos para uptime)
  cpuUso        Float?
  ramTotal      Float?
  ramUsada      Float?
  discoTotal    Float?
  discoLivre    Float?
  uptime        Float?
  ultimaMetrica DateTime?
}
