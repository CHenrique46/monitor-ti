# Dependências
node_modules/

# Arquivos de ambiente (NUNCA versionar .env com senhas)
.env
.env.local

# Builds
dist/
build/

# Logs
*.log
**/logs/

# Pacote de distribuicao gerado pelo build do agent (nao versionar)
release/

# Inventario administrativo e backups (podem conter chaves históricas)
/private/

# Releases de agente (artefatos gerados; metadados ficam no banco, nao no git)
releases/
!releases/**/.gitkeep

# Build do agent (bundle SEA)
agent/dist/

# Arquivos temporarios de teste / scratch
_tmp_*
scripts/_tmp_*
*.tmp
*.pid
*.err
*.previous

# Configuração local do agente (cada máquina tem seu próprio deviceId)
agent/data/

# SO / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
